{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jackjin1997/markindex",
  "title": "MarkIndex",
  "description": "Vectorless, structure-first search over large Markdown libraries: section trees + zh/en BM25",
  "repository": {
    "url": "https://github.com/jackjin1997/markindex",
    "source": "github"
  },
  "websiteUrl": "https://github.com/jackjin1997/markindex#readme",
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "markindex",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        {
          "type": "positional",
          "valueHint": "docs_dir",
          "description": "Directory of Markdown files to serve (the library root). The index lives in <docs_dir>/.markindex/.",
          "format": "filepath",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "--reindex-on-start",
          "description": "Incrementally (re)build the index on start; unchanged files are skipped."
        }
      ]
    }
  ]
}
