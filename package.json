{
  "name": "markindex",
  "version": "0.1.0",
  "description": "Vectorless, structure-first retrieval over large Markdown libraries for agents: section trees, mixed Chinese/English BM25 in SQLite, five read-only tools (AI SDK, MCP) and a built-in evidence loop",
  "author": "Zexu Jin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackjin1997/markindex.git"
  },
  "homepage": "https://github.com/jackjin1997/markindex#readme",
  "bugs": {
    "url": "https://github.com/jackjin1997/markindex/issues"
  },
  "keywords": [
    "markdown",
    "rag",
    "vectorless",
    "retrieval",
    "mcp",
    "mcp-server",
    "ai-agents",
    "pageindex",
    "bm25",
    "sqlite",
    "fts5",
    "typescript",
    "chinese"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "markindex": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/better-sqlite3": "^9.6.0",
    "ai": "^7.0.150",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "ignore": "^7.0.13",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
